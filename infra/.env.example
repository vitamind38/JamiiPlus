# Copy to infra/.env on the server and fill in every value. Never commit the filled copy.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Environment -------------------------------------------------------------------------
JAMII_ENVIRONMENT=production            # production | staging (staging holds synthetic reports only)
JAMII_VERSION=dev                        # image tag; deploy.sh sets this to the release tag
JAMII_DOMAIN=pulse.example.go.ke
JAMII_BASE_URL=https://pulse.example.go.ke
METABASE_DOMAIN=metabase.pulse.example.go.ke
GRAFANA_DOMAIN=grafana.pulse.example.go.ke

# --- Secrets -----------------------------------------------------------------------------
JAMII_SECRET_KEY=
JAMII_PSEUDONYM_KEY=
POSTGRES_PASSWORD=
JAMII_DB_PASSWORD=
JAMII_AUDIT_DB_PASSWORD=
METABASE_DB_PASSWORD=
METABASE_READER_PASSWORD=
MINIO_ROOT_USER=jamii
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- Africa's Talking ----------------------------------------------------------------------
JAMII_SMS_BACKEND=africastalking         # console prints SMS instead of sending (staging)
JAMII_AT_USERNAME=sandbox
JAMII_AT_API_KEY=
JAMII_AT_SANDBOX=true
JAMII_AT_SENDER_ID=
JAMII_USSD_SERVICE_CODE=*384*1234#
# Callback URLs in the Africa's Talking dashboard end with ?token=<this>
JAMII_CHANNEL_CALLBACK_TOKEN=
# Comma-free CIDR list Caddy accepts on /channels/ (Africa's Talking's published addresses)
AT_CALLBACK_ALLOW=0.0.0.0/0

# --- Pipeline ------------------------------------------------------------------------------
# manual: phases 1-2, people transcribe and tag everything. assisted: phase 3+, models behind review.
JAMII_PIPELINE_MODE=manual
# Above 1.0 = never auto-accept. Lower only to the value ml/scripts/thresholds.py recommends.
JAMII_CLASSIFY_MIN_CONFIDENCE=1.01
JAMII_TRANSCRIBE_MIN_CONFIDENCE=1.01
JAMII_NER_REDACTION_ENABLED=false
JAMII_SPIKE_ALERTS_ENABLED=false
JAMII_MODEL_EXTRAS=                       # whisper and/or ner once those models are approved

# --- Retention (confirm with the data protection impact assessment) -----------------------
JAMII_AUDIO_RETENTION_DAYS=30
JAMII_TEXT_RETENTION_DAYS=730

# --- Issues --------------------------------------------------------------------------------
JAMII_ISSUE_DEFAULT_LEVEL=cha             # who answers a new issue first: cha | subcounty | county
JAMII_CONSENT_VERSION=2026-10-v1          # bump when the privacy notice changes; CHPs re-consent

# --- Monitoring ----------------------------------------------------------------------------
JAMII_SENTRY_DSN=                         # self-hosted or EU/KE region; PII is never sent
